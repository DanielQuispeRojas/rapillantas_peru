# Copia este archivo a .env (NO lo commitees) y completa los valores reales.
# En produccion (Render/Hostinger/AWS/VPS) definelos en el panel de entorno del host.

# --- Backend (Spring Boot) ---
# Perfil activo: dev (default, ddl-auto create-drop) o prod (ddl-auto validate).
#
# ADMIN inicial (solo dev, seed @Profile("!prod")):
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=admin123
# ADMIN_NOMBRE=Administrador
SPRING_PROFILES_ACTIVE=dev

# Base de datos (dev usa defaults; en prod son obligatorios).
DB_URL=jdbc:postgresql://localhost:5432/rapillantas
DB_USER=moodu_dev
DB_PASS=1234

# Puerto del backend (default 8080).
SERVER_PORT=8080

# Google OAuth (vacio = boton "Registrate con Google" desactivado).
GOOGLE_CLIENT_ID=

# --- Frontend (Vite) ---
# Dejar vacio para usar el proxy de Vite (dev) o poner la URL publica del backend.
VITE_API_URL=
VITE_MOODU_URL=
